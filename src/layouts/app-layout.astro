---
// src/layouts/AppLayout.astro
//
// Shell for authenticated pages. Replaces the marketing navbar/footer of layout.astro
// with the app navigation. Padding adjusted to keep content from being covered by
// the bottom nav (mobile) or the sidebar (desktop).

import Navigation from '../components/navigation.astro';

interface Props {
  title?: string;
}

const { title = 'Gym Up' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Gym Up — Transforma tu cuerpo, supera tus límites. Tracking de entrenamiento para toda la familia." />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Theme Color -->
    <meta name="theme-color" content="#ff4d4d" />

    <title>⚡ {title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  </head>
  <body>
    <Navigation currentPath={currentPath} />
    <main class="app-main">
      <slot />
    </main>

    <style is:global>
      :root {
        color-scheme: dark;
      }

      body {
        margin: 0;
        min-height: 100vh;
        background: #0a0a0f;
        color: #fff;
        font-family: 'Inter', sans-serif;
      }

      .app-main {
        padding: 1.5rem;
        padding-bottom: calc(5rem + env(safe-area-inset-bottom));
        min-height: 100vh;
        box-sizing: border-box;
      }

      @media (min-width: 768px) {
        .app-main {
          padding: 2rem 2rem 2rem calc(240px + 2rem);
          padding-bottom: 2rem;
        }
      }
    </style>
  </body>
</html>
