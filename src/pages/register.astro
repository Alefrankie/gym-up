---
// src/pages/register.astro
//
// Registration page.
// Handles user registration with email, password, display name,
// routine type, and weight unit.

import Layout from '../layouts/layout.astro';
import AuthForm from '../components/auth-form.astro';
import { getAuthService } from '../lib/contexts/auth/auth.composition';
import { createSessionCookie, getSessionIdFromRequest } from '../lib/auth/cookie-helpers';

// Check if user is already logged in
const sessionId = getSessionIdFromRequest(Astro.request);
if (sessionId) {
  return Astro.redirect('/dashboard');
}

// Handle form submission
let error: string | undefined;

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const email = formData.get('email') as string;
    const password = formData.get('password') as string;
    const displayName = formData.get('displayName') as string;
    const routineType = formData.get('routineType') as 'hombre' | 'mujer';
    const weightUnit = formData.get('weightUnit') as 'kg' | 'lbs';

    // Validate input
    if (!email || !password || !displayName || !routineType || !weightUnit) {
      error = 'Todos los campos son requeridos';
    } else if (password.length < 6) {
      error = 'La contraseña debe tener al menos 6 caracteres';
    } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      error = 'Email inválido';
    } else {
      // Register user
      const authService = getAuthService();
      const session = await authService.register({
        email,
        password,
        displayName,
        routineType,
        weightUnit,
      });

      // Set session cookie and redirect
      const cookie = createSessionCookie(session.sessionId, session.expiresAt);
      return new Response(null, {
        status: 302,
        headers: {
          'Location': '/dashboard',
          'Set-Cookie': cookie,
        },
      });
    }
  } catch (e) {
    if (e instanceof Error) {
      error = e.message;
    } else {
      error = 'Error al crear la cuenta';
    }
  }
}
---

<Layout title="Crear Cuenta — Gym Up">
  <AuthForm mode="register" error={error} />
</Layout>
