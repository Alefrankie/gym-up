---
// src/pages/dashboard.astro
//
// Dashboard page.
// Shows user dashboard after login.

import Layout from '../layouts/layout.astro';
import { getAuthService } from '../lib/contexts/auth/auth.composition';
import { getSessionIdFromRequest } from '../lib/auth/cookie-helpers';

// Get session from cookie
const sessionId = getSessionIdFromRequest(Astro.request);
if (!sessionId) {
  return Astro.redirect('/login');
}

// Get current user
const authService = getAuthService();
const user = await authService.getCurrentUser(sessionId);

if (!user) {
  return Astro.redirect('/login');
}
---

<Layout title="Dashboard — Gym Up">
  <div class="dashboard-container">
    <div class="dashboard-header">
      <h1>Bienvenido, {user.displayName}!</h1>
      <p>Tu dashboard de entrenamiento</p>
    </div>
    
    <div class="dashboard-content">
      <div class="dashboard-card">
        <h2>Perfil</h2>
        <p><strong>Email:</strong> {user.email}</p>
        <p><strong>Rutina:</strong> {user.routineType}</p>
        <p><strong>Unidad de peso:</strong> {user.weightUnit}</p>
      </div>
      
      <div class="dashboard-card">
        <h2>Acciones Rápidas</h2>
        <div class="quick-actions">
          <a href="/workout" class="btn btn-primary">Iniciar Entrenamiento</a>
          <a href="/progress" class="btn btn-secondary">Ver Progreso</a>
          <a href="/nutrition" class="btn btn-secondary">Nutrición</a>
          <a href="/logout" class="btn btn-secondary">Cerrar Sesión</a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .dashboard-container {
    padding: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  
  .dashboard-header {
    margin-bottom: 2rem;
  }
  
  .dashboard-header h1 {
    font-family: 'Oswald', sans-serif;
    font-size: 2.5rem;
    font-weight: 700;
    color: #fff;
    margin: 0 0 0.5rem 0;
  }
  
  .dashboard-header p {
    color: rgba(255, 255, 255, 0.6);
    margin: 0;
  }
  
  .dashboard-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }
  
  .dashboard-card {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1rem;
    padding: 1.5rem;
  }
  
  .dashboard-card h2 {
    font-family: 'Oswald', sans-serif;
    font-size: 1.5rem;
    font-weight: 600;
    color: #fff;
    margin: 0 0 1rem 0;
  }
  
  .dashboard-card p {
    color: rgba(255, 255, 255, 0.8);
    margin: 0 0 0.5rem 0;
  }
  
  .quick-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.2s;
    cursor: pointer;
    border: none;
  }
  
  .btn-primary {
    background: linear-gradient(135deg, #ff4d4d 0%, #ff6b6b 100%);
    color: #fff;
  }
  
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px -10px rgba(255, 77, 77, 0.5);
  }
  
  .btn-secondary {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }
  
  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.15);
  }
</style>
