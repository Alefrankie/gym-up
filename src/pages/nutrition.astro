---
// src/pages/nutrition.astro
//
// Story 5.2 — Nutrition page (photo capture → AI analysis → result/edit).
// Story 5.3 — Added nutrition history + save flow.

import AppLayout from '../layouts/app-layout.astro';
import MealPhotoCapture from '../components/meal-photo-capture.astro';
import NutritionResult from '../components/nutrition-result.astro';
import NutritionHistory from '../components/nutrition-history.astro';
import { getAuthService } from '../lib/contexts/auth/auth.composition';
import { getSessionIdFromRequest } from '../lib/auth/cookie-helpers';
import { getGetNutritionHistoryUseCase } from '../lib/contexts/nutrition/nutrition.composition';

const sessionId = getSessionIdFromRequest(Astro.request);
if (!sessionId) {
  return Astro.redirect('/login');
}

const user = await getAuthService().getCurrentUser(sessionId);
if (!user) {
  return Astro.redirect('/login');
}

// Fetch nutrition history for the history section
const historyEntries = await getGetNutritionHistoryUseCase().execute({
  userId: user.id,
  limit: 10,
});
---

<AppLayout title="Nutrition — Gym Up">
  <div class="nutrition-page">
    <header class="nutrition-page-header">
      <h1>Nutrition</h1>
      <p class="nutrition-page-subtitle">
        Sacale foto a tu comida y recibí una estimación de calorías y macros.
      </p>
    </header>

    <MealPhotoCapture />

    <section class="nutrition-page-result" data-test-id="nutrition-result-section" aria-label="Resultado del análisis">
      <NutritionResult />
    </section>

    <NutritionHistory entries={historyEntries} />
  </div>
</AppLayout>

<style>
  .nutrition-page {
    max-width: 960px;
    margin: 0 auto;
  }

  .nutrition-page-header {
    margin-bottom: 1.5rem;
  }

  .nutrition-page-header h1 {
    font-family: 'Oswald', sans-serif;
    font-size: 2.25rem;
    font-weight: 700;
    color: #fff;
    margin: 0 0 0.4rem 0;
  }

  .nutrition-page-subtitle {
    margin: 0;
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.95rem;
  }

  .nutrition-page-result {
    margin-top: 1rem;
  }
</style>
