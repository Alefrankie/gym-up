    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .progress-header-text h1 {
    font-family: 'Oswald', sans-serif;
    font-size: 2.25rem;
    font-weight: 700;
    color: #fff;
    margin: 0 0 0.25rem 0;
  }

  .progress-header-text p {
    color: rgba(255, 255, 255, 0.6);
    margin: 0;
  }

  .btn-link {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.4rem 0.75rem;
    border-radius: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.04);
    transition: background-color 150ms ease, color 150ms ease;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .btn-link:hover,
  .btn-link:focus-visible {
    color: #fff;
    background: rgba(255, 255, 255, 0.1);
  }

  .btn-link:focus-visible {
    outline: 2px solid #ff4d4d;
    outline-offset: 2px;
  }

  .progress-card {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1rem;
    padding: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .progress-card h2 {
    font-family: 'Oswald', sans-serif;
    font-size: 1.5rem;
    font-weight: 600;
    color: #fff;
    margin: 0 0 0.75rem 0;
  }

  .progress-card p {
    color: rgba(255, 255, 255, 0.8);
    margin: 0 0 1rem 0;
  }

  .empty-state {
    text-align: center;
    padding: 2.5rem 1.5rem;
  }

  .empty-state h2 {
    color: #ffb84d;
  }

  .progress-selector {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .selector-label {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .selector-input {
    flex: 1 1 240px;
    min-width: 0;
    padding: 0.55rem 0.75rem;
    background: rgba(0, 0, 0, 0.3);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 0.5rem;
    font-size: 0.95rem;
    font-family: inherit;
  }

  .selector-input:focus-visible {
    outline: 2px solid #ff4d4d;
    outline-offset: 2px;
    border-color: #ff4d4d;
  }

  .range-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .range-btn {
    padding: 0.4rem 0.9rem;
