    font-size: 0.9rem;
    font-weight: 500;
    transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
  }

  .range-btn:hover,
  .range-btn:focus-visible {
    color: #fff;
    background: rgba(255, 255, 255, 0.1);
  }

