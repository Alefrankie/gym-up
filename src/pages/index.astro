---
// src/pages/index.astro
//
// Marketing landing page. Redirects to /dashboard if user has a valid session.

import Layout from '@/layouts/layout.astro';
import { getAuthService } from '../lib/contexts/auth/auth.composition';
import { getSessionIdFromRequest } from '../lib/auth/cookie-helpers';

const sessionId = getSessionIdFromRequest(Astro.request);
if (sessionId) {
  const authService = getAuthService();
  const user = await authService.getCurrentUser(sessionId);
  if (user) {
    return Astro.redirect('/dashboard');
  }
}
---
<Layout title="Gym Up — Transforma tu cuerpo">
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-bg">
      <div class="gradient-orb orb-1"></div>
      <div class="gradient-orb orb-2"></div>
      <div class="gradient-orb orb-3"></div>
      <div class="grid-overlay"></div>
    </div>
    <div class="hero-content">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        <span>App de Entrenamiento #1</span>
      </div>
      <h1 class="hero-title">
        <span class="title-line">Hoy toca</span>
        <span class="title-line title-accent">entrenar</span>
        <span class="title-line">y mejorar</span>
      </h1>
      <p class="hero-subtitle">
        Registra tu serie, mira tu progreso, repite.
      </p>
      <div class="hero-cta">
        <a href="/register" class="btn btn-primary">
          <span>Empezar a entrenar</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a href="/login" class="btn btn-secondary">
          <span>Ya tengo cuenta</span>
        </a>
      </div>
      <div class="hero-stats">
        <div class="stat">
          <span class="stat-number">⚡</span>
          <span class="stat-label">Rápido: 2 taps para empezar</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-number">👨‍👩‍👧‍👦</span>
          <span class="stat-label">Para toda la familia</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-number">🔒</span>
          <span class="stat-label">Tus datos son tuyos</span>
        </div>
      </div>
    </div>
    <div class="hero-visual">
      <div class="phone-mockup">
        <div class="phone-screen">
          <div class="app-header">
            <span class="app-logo">⚡</span>
            <span class="app-title">Gym Up</span>
          </div>
          <div class="app-workout">
            <div class="workout-card">
              <span class="workout-icon">🏋️</span>
              <span class="workout-name">Press de Banca</span>
              <span class="workout-sets">4 x 12</span>
            </div>
            <div class="workout-card">
              <span class="workout-icon">💪</span>
              <span class="workout-name">Curl de Bíceps</span>
              <span class="workout-sets">3 x 15</span>
            </div>
            <div class="workout-card">
              <span class="workout-icon">🦵</span>
              <span class="workout-name">Sentadillas</span>
              <span class="workout-sets">4 x 10</span>
            </div>
          </div>
          <div class="app-progress">
            <div class="progress-bar">
              <div class="progress-fill" style="width: 75%"></div>
            </div>
            <span class="progress-text">75% completado</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Value Section (Story 2.7: reworded from a 6-card catalog to a short statement) -->
  <section id="features" class="features">
    <div class="section-container">
      <div class="section-header">
        <span class="section-tag">EN POCAS PALABRAS</span>
        <h2 class="section-title">Una app simple para <span class="text-accent">entrenar de verdad</span></h2>
        <p class="section-subtitle">Marca tus series, mira cómo progresas, vuelve mañana. Sin catálogo, sin relleno.</p>
      </div>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">🏋️</div>
          <h3>Marca y sigue</h3>
          <p>Cada serie, cada peso, cada repetición. El registro se vuelve parte del entrenamiento, no un trámite.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">📈</div>
          <h3>Progresa semana a semana</h3>
          <p>Gráficos claros que te muestran cuánto has mejorado. Tú vs. tú, sin compararte con nadie.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works Section -->
  <section id="how-it-works" class="how-it-works">
    <div class="section-container">
      <div class="section-header">
        <span class="section-tag">CÓMO FUNCIONA</span>
        <h2 class="section-title">Empieza en <span class="text-accent">3 pasos</span></h2>
      </div>
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-number">01</div>
          <h3>Crea tu perfil</h3>
          <p>Regístrate en segundos. Cuéntanos tus objetivos y nivel de experiencia.</p>
        </div>
        <div class="step-connector">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </div>
        <div class="step-card">
          <div class="step-number">02</div>
          <h3>Elige tu rutina</h3>
          <p>Selecciona entre rutinas prediseñadas o crea la tuya propia.</p>
        </div>
        <div class="step-connector">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </div>
        <div class="step-card">
          <div class="step-number">03</div>
          <h3>Entrena y progresa</h3>
          <p>Registra tus entrenamientos y mira cómo mejoras cada semana.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section id="cta" class="cta-section">
    <div class="cta-container">
      <div class="cta-bg">
        <div class="cta-orb cta-orb-1"></div>
        <div class="cta-orb cta-orb-2"></div>
      </div>
      <div class="cta-content">
        <h2>¿Listo para transformarte?</h2>
        <p>Únete a miles de personas que ya están alcanzando sus objetivos con Gym Up.</p>
        <a href="/register" class="btn btn-primary btn-large">
          <span>Empezar Gratis</span>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <p class="cta-note">Sin tarjeta de crédito. Cancela cuando quieras.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ========== HERO SECTION ========== */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 120px 2rem 80px;
    position: relative;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .gradient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    animation: float 8s ease-in-out infinite;
  }

  .orb-1 {
    width: 600px;
    height: 600px;
    background: var(--glow-primary);
    top: -200px;
    right: -100px;
    animation-delay: 0s;
  }

  .orb-2 {
    width: 400px;
    height: 400px;
    background: var(--glow-accent);
    bottom: -100px;
    left: -100px;
    animation-delay: 2s;
  }

  .orb-3 {
    width: 300px;
    height: 300px;
    background: rgba(128, 0, 255, 0.3);
    top: 50%;
    left: 50%;
    animation-delay: 4s;
  }

  .grid-overlay {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 50px 50px;
  }

  .hero-content {
    max-width: var(--container-width);
    margin: 0 auto;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 77, 77, 0.1);
    border: 1px solid rgba(255, 77, 77, 0.3);
    padding: 0.5rem 1rem;
    border-radius: 50px;
    font-size: 0.85rem;
    color: var(--primary-light);
    margin-bottom: 1.5rem;
    grid-column: 1;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background: var(--primary);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 3px;
    grid-column: 1;
  }

  .title-line {
    display: block;
  }

  .title-accent {
    color: var(--primary);
    text-shadow: 0 0 40px var(--glow-primary);
  }

  .hero-subtitle {
    font-size: 1.2rem;
    color: var(--text-secondary);
    max-width: 500px;
    grid-column: 1;
    line-height: 1.8;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    grid-column: 1;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    border-radius: 12px;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
    border: none;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: white;
    box-shadow: 0 4px 20px var(--glow-primary);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px var(--glow-primary);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-primary);
    border: 1px solid var(--border);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .btn-large {
    padding: 1.2rem 2.5rem;
    font-size: 1.1rem;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 2rem;
    grid-column: 1;
    margin-top: 2rem;
  }

  .stat {
    display: flex;
    flex-direction: column;
  }

  .stat-number {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .stat-label {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .stat-divider {
    width: 1px;
    height: 40px;
    background: var(--border);
  }

  /* Hero Visual - Phone Mockup */
  .hero-visual {
    grid-column: 2;
    grid-row: 1 / span 5;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .phone-mockup {
    width: 280px;
    height: 560px;
    background: var(--bg-card);
    border-radius: 40px;
    border: 3px solid rgba(255, 255, 255, 0.1);
    padding: 20px;
    box-shadow: 
      0 0 60px rgba(255, 77, 77, 0.2),
      0 0 120px rgba(0, 212, 255, 0.1);
    animation: float 6s ease-in-out infinite;
    position: relative;
    overflow: hidden;
  }

  .phone-mockup::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 120px;
    height: 25px;
    background: var(--bg-dark);
    border-radius: 0 0 20px 20px;
  }

  .phone-screen {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 20px;
  }

  .app-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .app-logo {
    font-size: 1.5rem;
  }

  .app-title {
    font-family: var(--font-heading);
    font-weight: 700;
    letter-spacing: 1px;
  }

  .app-workout {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }

  .workout-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    animation: slideUp 0.5s ease-out backwards;
  }

  .workout-card:nth-child(1) { animation-delay: 0.2s; }
  .workout-card:nth-child(2) { animation-delay: 0.4s; }
  .workout-card:nth-child(3) { animation-delay: 0.6s; }

  .workout-icon {
    font-size: 1.5rem;
  }

  .workout-name {
    flex: 1;
    font-weight: 500;
    font-size: 0.9rem;
  }

  .workout-sets {
    color: var(--primary);
    font-weight: 600;
    font-size: 0.85rem;
  }

  .app-progress {
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .progress-bar {
    height: 8px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 0.5rem;
  }

  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--primary), var(--accent));
    border-radius: 4px;
    animation: progressGrow 1.5s ease-out 0.8s backwards;
  }

  .progress-text {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  /* ========== FEATURES SECTION ========== */
  .features {
    padding: var(--section-padding);
    background: var(--bg-dark);
    position: relative;
  }

  .section-container {
    max-width: var(--container-width);
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-tag {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 3px;
    color: var(--primary);
    margin-bottom: 1rem;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: 1px;
    margin-bottom: 1rem;
  }

  .text-accent {
    color: var(--primary);
  }

  .section-subtitle {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .feature-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 2.5rem;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .feature-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--primary), var(--accent));
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .feature-card:hover {
    background: var(--bg-card-hover);
    border-color: rgba(255, 77, 77, 0.3);
    transform: translateY(-5px);
  }

  .feature-card:hover::before {
    opacity: 1;
  }

  .feature-icon {
    font-size: 2.5rem;
    margin-bottom: 1.5rem;
  }

  .feature-card h3 {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    letter-spacing: 0.5px;
  }

  .feature-card p {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  /* ========== HOW IT WORKS SECTION ========== */
  .how-it-works {
    padding: var(--section-padding);
    background: linear-gradient(180deg, var(--bg-dark) 0%, rgba(18, 18, 26, 1) 100%);
  }

  .steps-grid {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .step-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 3rem 2.5rem;
    text-align: center;
    max-width: 300px;
    flex: 1;
    transition: all 0.3s ease;
  }

  .step-card:hover {
    border-color: rgba(0, 212, 255, 0.3);
    transform: translateY(-5px);
  }

  .step-number {
    font-family: var(--font-heading);
    font-size: 4rem;
    font-weight: 700;
    color: var(--primary);
    opacity: 0.3;
    margin-bottom: 1rem;
  }

  .step-card h3 {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    letter-spacing: 0.5px;
  }

  .step-card p {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .step-connector {
    color: var(--text-muted);
    animation: bounceRight 1.5s ease-in-out infinite;
  }

  /* ========== CTA SECTION ========== */
  .cta-section {
    padding: 120px 2rem;
    position: relative;
  }

  .cta-container {
    max-width: 800px;
    margin: 0 auto;
    background: linear-gradient(135deg, var(--bg-card) 0%, rgba(255, 77, 77, 0.1) 100%);
    border: 1px solid rgba(255, 77, 77, 0.2);
    border-radius: 30px;
    padding: 4rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .cta-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .cta-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
  }

  .cta-orb-1 {
    width: 300px;
    height: 300px;
    background: var(--glow-primary);
    top: -100px;
    right: -100px;
  }

  .cta-orb-2 {
    width: 200px;
    height: 200px;
    background: var(--glow-accent);
    bottom: -50px;
    left: -50px;
  }

  .cta-content {
    position: relative;
    z-index: 1;
  }

  .cta-content h2 {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 700;
    margin-bottom: 1rem;
    letter-spacing: 1px;
  }

  .cta-content > p {
    color: var(--text-secondary);
    font-size: 1.1rem;
    margin-bottom: 2rem;
  }

  .cta-note {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: 1rem;
  }

  /* ========== ANIMATIONS ========== */
  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes progressGrow {
    from { width: 0; }
  }

  @keyframes bounceRight {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(10px); }
  }

  /* ========== RESPONSIVE ========== */
  @media (max-width: 968px) {
    .hero-content {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-badge,
    .hero-subtitle,
    .hero-cta,
    .hero-stats {
      grid-column: 1;
      justify-content: center;
    }

    .hero-subtitle {
      margin: 0 auto;
    }

    .hero-visual {
      grid-column: 1;
      grid-row: auto;
      margin-top: 3rem;
    }

    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .steps-grid {
      flex-direction: column;
    }

    .step-connector {
      transform: rotate(90deg);
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 100px 1rem 60px;
    }

    .hero-cta {
      flex-direction: column;
    }

    .hero-stats {
      flex-direction: column;
      gap: 1rem;
    }

    .stat-divider {
      width: 40px;
      height: 1px;
    }

    .features-grid {
      grid-template-columns: 1fr;
    }

    .cta-container {
      padding: 3rem 1.5rem;
    }
  }
</style>
