---
// src/components/streak-counter.astro
//
// Story 3.3 — Streak counter component.
// Displays current streak + total workouts completed.
// Pure SSR, zero JS. Spanish labels.

import type { Streak } from '../lib/contexts/progress/domain/progress.types';

interface Props {
  streak: Streak;
}

const { streak } = Astro.props;
---

<div class="streak-card">
  <div class="streak-header">
    <h3 class="streak-title">Tu racha</h3>
  </div>
  
  <div class="streak-content">
    <div class="streak-current">
      <span class="streak-emoji">🔥</span>
      <span class="streak-count">{streak.current}</span>
      <span class="streak-label">{streak.current === 1 ? 'día' : 'días'}</span>
    </div>
    
    <div class="streak-divider"></div>
    
    <div class="streak-total">
      <span class="total-label">Total</span>
      <span class="total-count">{streak.total}</span>
      <span class="total-sublabel">{streak.total === 1 ? 'entrenamiento' : 'entrenamientos'}</span>
    </div>
  </div>
  
  {streak.current === 0 && (
    <p class="streak-hint">¡Empieza tu racha hoy!</p>
  )}
</div>

<style>
  .streak-card {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1rem;
    padding: 1.5rem;
  }

  .streak-header {
    margin-bottom: 1.25rem;
  }

  .streak-title {
    font-family: 'Oswald', sans-serif;
    font-size: 1.5rem;
    font-weight: 600;
    color: #fff;
    margin: 0;
  }

  .streak-content {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .streak-current {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex: 1;
  }

  .streak-emoji {
    font-size: 2rem;
    line-height: 1;
  }

  .streak-count {
    font-family: 'Oswald', sans-serif;
    font-size: 3rem;
    font-weight: 700;
    color: #ff4d4d;
    line-height: 1;
  }

  .streak-label {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.7);
    font-weight: 500;
  }

  .streak-divider {
    width: 1px;
    height: 3rem;
    background: rgba(255, 255, 255, 0.15);
  }

  .streak-total {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 80px;
  }

  .total-label {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.5);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.25rem;
  }

  .total-count {
    font-family: 'Oswald', sans-serif;
    font-size: 2rem;
    font-weight: 700;
    color: #fff;
    line-height: 1;
  }

  .total-sublabel {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.5);
    margin-top: 0.25rem;
  }

  .streak-hint {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.9rem;
    text-align: center;
    margin-bottom: 0;
  }

  /* Responsive */
  @media (max-width: 480px) {
    .streak-card {
      padding: 1.25rem;
    }

    .streak-content {
      flex-direction: column;
      gap: 1rem;
    }

    .streak-divider {
      width: 100%;
      height: 1px;
    }

    .streak-count {
      font-size: 2.5rem;
    }

    .total-count {
      font-size: 1.75rem;
    }
  }
</style>
