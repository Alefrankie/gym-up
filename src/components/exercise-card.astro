---
// src/components/exercise-card.astro
//
// Story 2.3 — exercise-card. Render-only UI component for logging sets
// during a workout. Pure presentational — no DB access, no form submission.
// Per docs/architecture/components.md ExerciseCard prop table.
//
// 2.4 (Log Set auto-save) wraps the page in a workout page; the auto-save
// module reads the row's data and POSTs to /api/workout-entries. The card
// receives `initialEntries` to pre-fill saved values for the resume path
// (FR-WT-013). 2.5 (Rest Timer) will hook into the checkmark tap inside
// this card. For 2.3, the only client-side logic is the "+ Add set" button
// (inline <script> below) — pure UI, no submission.

import { WorkoutEntryRules } from '../lib/contexts/workout-tracking/domain/workout-tracking.constants';
import type { WorkoutEntry } from '@db/schema';

interface Props {
  exerciseName: string;
  targetSets: number;
  targetReps: number;
  exerciseId: string;
  /** Reserved for 2.4 (auto-save) and 2.5 (rest-timer). Not emitted as a hidden input in 2.3. */
  workoutId: string;
  weightUnit: 'kg' | 'lbs';
  /**
   * Existing entries to pre-fill the form (for resume / partial save).
   * Story 2.4: page passes entries grouped by exerciseId.
   * Defaults to empty (no pre-fill).
   */
  initialEntries?: WorkoutEntry[];
}

const {
  exerciseName,
  targetSets,
  targetReps,
  exerciseId,
  workoutId: _workoutId,
  weightUnit,
  initialEntries = [],
} = Astro.props;
const maxSets = WorkoutEntryRules.MaxSetsPerExercise; // 10

// Convert stored kg weight back to the user's unit for display (roundtrip
// — use case converts lbs→kg on save, card converts kg→lbs on load).
const displayWeight = (entry: WorkoutEntry | undefined): number | undefined => {
  if (!entry) return undefined;
  return weightUnit === 'lbs' ? entry.weight * 2.20462 : entry.weight;
};

---

<article class="exercise-card" aria-labelledby={`exercise-${exerciseId}-name`}>
  <header class="exercise-card-header">
    <h3 id={`exercise-${exerciseId}-name`} class="exercise-card-name">{exerciseName}</h3>
    <p class="exercise-card-target">×{targetSets} × {targetReps} reps</p>
  </header>

  <ol class="set-list" data-target-sets={targetSets} data-max-sets={maxSets}>
    {Array.from({ length: targetSets }, (_, i) => i + 1).map((setNumber) => {
      const entry = initialEntries.find((e) => e.setNumber === setNumber);
      return (
        <li class="set-row" data-set-number={setNumber}>
          <span class="set-number" aria-hidden="true">{setNumber}</span>
          <label class="set-field">
            <span class="set-label">Reps</span>
            <input
              type="number"
              name={`entries[${setNumber}][reps]`}
              min={WorkoutEntryRules.MinReps}
              max={WorkoutEntryRules.MaxReps}
              placeholder={String(targetReps)}
              inputmode="numeric"
              class="set-input"
              value={entry?.reps}
            />
          </label>
          <label class="set-field">
            <span class="set-label">Peso ({weightUnit})</span>
            <input
              type="number"
              name={`entries[${setNumber}][weight]`}
              min={WorkoutEntryRules.MinWeight}
              max={WorkoutEntryRules.MaxWeight}
              step="0.5"
              inputmode="decimal"
              class="set-input"
              value={displayWeight(entry)}
            />
          </label>
          <label class="set-field set-field-checkbox set-field-done">
            <span class="set-label">✓ Hecho</span>
            <input
              type="checkbox"
              name={`entries[${setNumber}][completed]`}
              value="true"
              class="set-checkbox"
              checked={entry?.completed ?? false}
            />
          </label>
          <details class="set-field set-field-notes">
            <summary class="set-notes-summary">
              <span aria-hidden="true">✏️</span> nota <span class="set-label-optional">(opcional)</span>
            </summary>
            <input
              type="text"
              name={`entries[${setNumber}][notes]`}
              maxlength={WorkoutEntryRules.MaxNotesLength}
              placeholder="Ej: sentí bien el último"
              class="set-input"
              value={entry?.notes ?? ''}
            />
          </details>
          <input type="hidden" name={`entries[${setNumber}][exercise_id]`} value={exerciseId} />
        </li>
      );
    })}
  </ol>

  <button type="button" class="add-set-button" data-action="add-set" hidden={targetSets >= maxSets}>
    + Añadir set
  </button>
</article>

<script>
  // Client-side "+ Add set" handler. Clones the last set row, increments
  // the set number, updates input name attributes (entries[N][...] →
  // entries[N+1][...]). Resets all field values on the cloned row.
  // Caps at WorkoutEntryRules.MaxSetsPerExercise (= 10) — when reached,
  // the button hides via updateButtonVisibility().
  document.querySelectorAll<HTMLElement>('.exercise-card').forEach((card) => {
    const setList = card.querySelector('.set-list') as HTMLOListElement | null;
    const addButton = card.querySelector('[data-action="add-set"]') as HTMLButtonElement | null;
    const maxSets = Number(setList?.dataset.maxSets ?? '10');
    if (!setList || !addButton) return;

    const updateButtonVisibility = () => {
      const currentSets = setList.querySelectorAll('.set-row').length;
      addButton.hidden = currentSets >= maxSets;
    };

    // Story 2.7 — pre-fill propagation.
    // When the user types reps or weight in row N, copy the value to row N+1
    // ONLY if N+1's matching field is empty. First set of the card has no
    // previous row, so it stays empty and uses targetReps as placeholder
    // (rendered server-side). Works for dynamically cloned rows too.
    const propagateIfEmpty = (sourceInput: HTMLInputElement) => {
      const row = sourceInput.closest<HTMLLIElement>('.set-row');
      if (!row) return;
      const setNumber = Number(row.dataset.setNumber ?? '0');
      const fieldMatch = sourceInput.name.match(/entries\[\d+\]\[(\w+)\]/);
      const field = fieldMatch?.[1];
      if (!field) return;
      const nextRow = setList.querySelector<HTMLLIElement>(
        `.set-row[data-set-number="${setNumber + 1}"]`
      );
      if (!nextRow) return;
      const nextInput = nextRow.querySelector<HTMLInputElement>(
        `input[name="entries[${setNumber + 1}][${field}]"]`
      );
      if (nextInput && nextInput.value === '') {
        nextInput.value = sourceInput.value;
      }
    };

    setList.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement | null;
      if (!target || !target.name) return;
      if (target.name.endsWith('[reps]') || target.name.endsWith('[weight]')) {
        propagateIfEmpty(target);
      }
    });

    addButton.addEventListener('click', () => {
      const rows = setList.querySelectorAll<HTMLLIElement>('.set-row');
      const lastRow = rows[rows.length - 1];
      if (!lastRow) return;
      const nextSetNumber = Number(lastRow.dataset.setNumber ?? '0') + 1;
      if (nextSetNumber > maxSets) return;

      const newRow = lastRow.cloneNode(true) as HTMLLIElement;
      newRow.dataset.setNumber = String(nextSetNumber);
      const setNumberLabel = newRow.querySelector('.set-number');
      if (setNumberLabel) setNumberLabel.textContent = String(nextSetNumber);

      // Update input name attributes: entries[N][field] → entries[N+1][field].
      // Story 2.7 — reps and weight INHERIT from the source row so the new
      // set starts with the same values. Checkbox and notes reset.
      newRow.querySelectorAll<HTMLInputElement>('input[name^="entries["]').forEach((input) => {
        const oldName = input.getAttribute('name') ?? '';
        const newName = oldName.replace(/entries\[\d+\]/, `entries[${nextSetNumber}]`);
        input.setAttribute('name', newName);
        const fieldMatch = oldName.match(/entries\[\d+\]\[(\w+)\]/);
        const field = fieldMatch?.[1];
        if (input.type === 'checkbox') {
          input.checked = false;
        } else if (field === 'reps' || field === 'weight') {
          const sourceInput = lastRow.querySelector<HTMLInputElement>(
            `input[name="${oldName}"]`
          );
          input.value = sourceInput?.value ?? '';
        } else {
          input.value = '';
        }
      });

      setList.appendChild(newRow);
      updateButtonVisibility();
    });

    updateButtonVisibility();
  });
</script>

<style>
  .exercise-card {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.75rem;
    padding: 1.25rem;
    margin-bottom: 1rem;
  }

  .exercise-card-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.85rem;
  }

  .exercise-card-name {
    font-family: 'Oswald', sans-serif;
    font-size: 1.15rem;
    font-weight: 600;
    color: #fff;
    margin: 0;
  }

  .exercise-card-target {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.85rem;
    margin: 0;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .set-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .set-row {
    display: grid;
    grid-template-columns: auto 1fr 1fr auto 1.5fr;
    gap: 0.5rem;
    align-items: end;
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .set-row:last-child {
    border-bottom: none;
  }

  .set-number {
    font-family: 'Oswald', sans-serif;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.9rem;
    width: 1.5rem;
    text-align: center;
  }

  .set-field {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .set-label {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .set-label-optional {
    color: rgba(255, 255, 255, 0.35);
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.65rem;
  }

  .set-input {
    background: rgba(0, 0, 0, 0.3);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 0.4rem;
    padding: 0.45rem 0.6rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    width: 100%;
    box-sizing: border-box;
  }

  .set-input:focus-visible {
    outline: 2px solid #ff4d4d;
    outline-offset: 2px;
    border-color: #ff4d4d;
  }

  .set-field-checkbox {
    align-items: center;
  }

  /* Story 2.7 — primary completion action. */
  .set-field-done {
    background: rgba(255, 77, 77, 0.08);
    border: 1px solid rgba(255, 77, 77, 0.25);
    border-radius: 0.5rem;
    padding: 0.4rem 0.55rem;
    transition: background-color 150ms ease, border-color 150ms ease;
  }

  .set-field-done:has(.set-checkbox:checked) {
    background: rgba(255, 77, 77, 0.25);
    border-color: rgba(255, 77, 77, 0.6);
  }

  .set-field-done .set-label {
    color: #ff8a8a;
    font-weight: 600;
  }

  .set-field-done:has(.set-checkbox:checked) .set-label {
    color: #fff;
  }

  .set-checkbox {
    width: 1.4rem;
    height: 1.4rem;
    cursor: pointer;
    accent-color: #ff4d4d;
  }

  /* Story 2.7 — notes collapsed by default. */
  .set-field-notes {
    margin: 0;
  }

  .set-notes-summary {
    list-style: none;
    cursor: pointer;
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0;
    user-select: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .set-notes-summary::-webkit-details-marker {
    display: none;
  }

  .set-notes-summary::before {
    content: '+';
    display: inline-block;
    width: 1rem;
    height: 1rem;
    line-height: 1rem;
    text-align: center;
    border-radius: 0.25rem;
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.85rem;
  }

  details[open] > .set-notes-summary::before {
    content: '−';
  }

  .set-field-notes .set-input {
    margin-top: 0.35rem;
  }

  .add-set-button {
    margin-top: 0.5rem;
    background: rgba(255, 77, 77, 0.12);
    color: #ff8a8a;
    border: 1px dashed rgba(255, 77, 77, 0.3);
    border-radius: 0.4rem;
    padding: 0.5rem 0.85rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .add-set-button:hover,
  .add-set-button:focus-visible {
    background: rgba(255, 77, 77, 0.2);
    color: #fff;
  }

  .add-set-button:focus-visible {
    outline: 2px solid #ff4d4d;
    outline-offset: 2px;
  }

  @media (max-width: 700px) {
    .set-row {
      grid-template-columns: auto 1fr 1fr;
      row-gap: 0.4rem;
    }
    .set-field-checkbox,
    .set-field-notes {
      grid-column: 1 / -1;
    }
  }
</style>
