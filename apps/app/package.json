{
  "name": "@gym-up/app",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "deploy:web": "node scripts/deploy-web.mjs",
    "android:debug": "node scripts/android-debug.mjs",
    "android:share": "node scripts/android-share.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "fake-indexeddb": "^6.2.6",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@gym-up/contracts": "workspace:*",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-notification": "~2.8.0",
    "chart.js": "^4.6.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "imports": {
    "#lib/session": "./src/lib/session.svelte.ts",
    "#lib/offline/sync.svelte": "./src/lib/offline/sync.svelte.ts",
    "#lib/offline/rest.svelte": "./src/lib/offline/rest.svelte.ts",
    "#lib/offline/workout-view.svelte": "./src/lib/offline/workout-view.svelte.ts",
    "#lib/i18n": "./src/lib/i18n/index.svelte.ts",
    "#lib/*.svelte": "./src/lib/*.svelte",
    "#lib/*": "./src/lib/*.ts"
  }
}
