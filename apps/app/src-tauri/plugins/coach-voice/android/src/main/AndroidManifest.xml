<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The rest-end line (and the rest-end notification) must sound on time with the screen locked.
         USE_EXACT_ALARM is granted at install on Android 13+; SCHEDULE_EXACT_ALARM covers Android 12. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />

    <application>
        <receiver android:name="com.gymup.coachvoice.RestSpeechReceiver" android:exported="false" />
    </application>
</manifest>
