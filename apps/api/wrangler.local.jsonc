{
  "name": "gym-up-api-local",
  "main": "build/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Browser origins allowed by CORS in addition to the Tauri origins (comma separated).
  "vars": { "EXTRA_ORIGINS": "https://gym-up-web.gymup-phase0-spike.workers.dev" },
  // Local development only: `wrangler dev --local` simulates this bucket, nothing is created in the cloud.
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "gym-up-photos" }, { "binding": "COACH_AUDIO", "bucket_name": "gym-up-coach-audio" }],
  // Workers AI always runs in the cloud, even in local dev (each new Coach line is a real, billed generation).
  "ai": { "binding": "AI", "remote": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gym-up",
      // Replace with the id printed by `wrangler d1 create gym-up`.
      "database_id": "236195c7-7bc8-4993-802b-23f47eb92e4d",
      "migrations_dir": "db/migrations"
    }
  ],
  "alias": {
    // Nest lazily imports optional packages that are not installed; stub them for the bundler.
    "@nestjs/microservices": "./stubs/stub.js",
    "@nestjs/microservices/microservices-module.js": "./stubs/stub.js",
    "@nestjs/websockets/socket-module.js": "./stubs/stub.js",
    "class-validator": "./stubs/stub.js",
    "class-transformer": "./stubs/stub.js",
    // The schema lives outside src/, so SWC leaves this import alone and the bundler resolves it.
    "@db/schema": "./db/schema.ts"
  }
}
