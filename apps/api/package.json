{
  "name": "@gym-up/api",
  "private": true,
  "type": "module",
  "version": "0.10.1",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx db/seed-cli.ts",
    "db:studio": "drizzle-kit studio",
    "build:worker": "node scripts/make-swcrc.mjs && swc src -d build --strip-leading-paths --config-file .swcrc --ignore \"**/*.d.ts\" && node scripts/copy-wasm-json.mjs",
    "dev:worker": "pnpm build:worker && wrangler dev --local --config wrangler.local.jsonc --ip 0.0.0.0 --port 8787",
    "deploy": "pnpm build:worker && wrangler deploy",
    "db:seed-sql": "tsx scripts/gen-seed-sql.ts",
    "d1:migrate:local": "wrangler d1 migrations apply gym-up --local",
    "d1:seed:local": "wrangler d1 execute gym-up --local --file db/seed.sql",
    "d1:migrate:remote": "wrangler d1 migrations apply gym-up --remote",
    "d1:seed:remote": "wrangler d1 execute gym-up --remote --file db/seed.sql"
  },
  "dependencies": {
    "@gym-up/contracts": "workspace:*",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "argon2-wasm-edge": "^1.0.23",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.20",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  }
}
